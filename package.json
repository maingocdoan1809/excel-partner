{
  "name": "office-partner",
  "version": "0.1.23",
  "description": "Excel Partner (Office Partner): local Word, Excel and PowerPoint desktop AI add-in with Claude Code, GitHub Copilot CLI, Codex CLI and OpenCode CLI providers.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maingocdoan1809/excel-partner.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "office-partner": "bin/office-partner.mjs",
    "office-partner-doctor": "bin/doctor.mjs",
    "agent-gateway": "gateway/bin/agent-gateway.mjs"
  },
  "files": [
    "npm-shrinkwrap.json",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md",
    "frontend/assets/",
    "frontend/dist/",
    "frontend/manifest.xml",
    "frontend/taskpane/index.html",
    "frontend/taskpane/styles.css",
    "frontend/taskpane/workspace.css",
    "bin/",
    "gateway/bin/",
    "gateway/dist/*.mjs",
    "gateway/README.md",
    "docs/mcp-runtime.md",
    "docs/diagnostics.md",
    "docs/managed-runtime-validation.md",
    "dist/bridge/src/",
    "dist/shared/src/",
    "dist/excel_mcp/src/",
    "dist/protocol/src/",
    "dist/providers/src/",
    "scripts/package-windows.ps1",
    "scripts/workspace-windows.ps1",
    "docs/history-storage.md",
    "docs/admin-policy.md",
    "docs/enterprise-deployment.md",
    "docs/privacy-and-data-flow.md",
    "!**/*.map"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0 <26.0.0"
  },
  "scripts": {
    "update:codex-commands": "node scripts/update-codex-commands.mjs",
    "build": "npm run build:server && npm run build:frontend && npm run build:gateway",
    "build:gateway": "node scripts/build-gateway.mjs",
    "build:server": "tsc -p tsconfig.json",
    "build:frontend": "esbuild frontend/taskpane/main.ts --bundle --format=iife --target=es2020 --legal-comments=linked --outfile=frontend/dist/taskpane.js",
    "prepack": "npm run build && node scripts/third-party-notices.mjs",
    "clean": "rm -rf dist frontend/dist",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p frontend/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:browser": "npm run build && node scripts/test-browser.mjs",
    "test:watch": "vitest",
    "bridge": "node dist/bridge/src/index.js",
    "dev": "node scripts/dev-local.mjs",
    "dev:bridge": "tsx watch bridge/src/index.ts",
    "dev:gateway": "node scripts/dev-gateway.mjs",
    "pack:release": "node scripts/pack-release.mjs",
    "smoke": "tsx scripts/live-smoke.ts",
    "test:live": "vitest run tests/providers.live.test.ts"
  },
  "dependencies": {
    "@github/copilot-sdk": "1.0.34",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-sqlite3": "12.9.0",
    "cross-spawn": "^7.0.6",
    "dompurify": "^3.4.17",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "koffi": "3.3.6",
    "marked": "^18.1.1",
    "selfsigned": "^5.5.0",
    "ws": "^8.18.0",
    "yaml": "^2.9.1",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.0",
    "@types/office-js": "^1.0.400",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.24.0",
    "jsdom": "^30.1.3",
    "playwright-core": "1.64.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}

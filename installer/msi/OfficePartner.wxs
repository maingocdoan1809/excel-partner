<?xml version="1.0" encoding="utf-8"?>
<!--
  Office Partner: thin per-user MSI (WiX 5). Build it with scripts/build-msi.mjs, which passes Version and PayloadDir.
  It installs the package into %APPDATA%\npm\node_modules\office-partner, where `npm install -g` would put it, so `office-partner update` keeps working.
  Node.js and the Copilot CLI are not inside: installer/msi/bootstrap.ps1 downloads the exact versions pinned in bin/runtime-manifest.json.
  Public properties (msiexec ... PROVIDERS=copilot NOSIDELOAD=1 /qn): PROVIDERS (default copilot), NOSIDELOAD (deploy the manifest from Microsoft 365 instead).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="Office Partner" Manufacturer="Office Partner" Version="$(Version)" UpgradeCode="552e7bb6-e522-4ea5-8264-96392d389aed"
           Scope="perUser" InstallerVersion="500" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Office Partner is already installed." Schedule="afterInstallInitialize" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Property Id="PROVIDERS" Value="copilot" Secure="yes" />
    <Property Id="NOSIDELOAD" Secure="yes" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <!-- Where the package was installed, remembered so uninstall can remove files `office-partner update` added later. -->
    <Property Id="PACKAGEDIR">
      <RegistrySearch Id="PackageDirSearch" Root="HKCU" Key="Software\Office Partner" Name="InstallDir" Type="directory" />
    </Property>

    <StandardDirectory Id="AppDataFolder">
      <Directory Id="NpmDir" Name="npm">
        <Directory Id="NodeModulesDir" Name="node_modules">
          <Directory Id="INSTALLFOLDER" Name="office-partner" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <ComponentGroup Id="PackageFiles" Directory="INSTALLFOLDER">
      <Files Include="$(PayloadDir)\node_modules\office-partner\**" />
    </ComponentGroup>
    <ComponentGroup Id="CommandShim" Directory="NpmDir">
      <Files Include="$(PayloadDir)\office-partner.cmd" />
    </ComponentGroup>
    <ComponentGroup Id="Cleanup" Directory="INSTALLFOLDER">
      <Component Id="InstallDirRecord" Guid="0f6c3a52-5d0e-4a39-9a43-3c1a6f7d2b11">
        <RegistryValue Root="HKCU" Key="Software\Office Partner" Name="InstallDir" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
        <util:RemoveFolderEx On="uninstall" Property="PACKAGEDIR" />
      </Component>
    </ComponentGroup>

    <!-- PowerShell runs as the signed-in user. Failing the install step rolls the copied files back. -->
    <CustomAction Id="Install" Directory="INSTALLFOLDER" Execute="deferred" Impersonate="yes" Return="check"
                  ExeCommand="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]installer\bootstrap.ps1&quot; -Action install -Providers &quot;[PROVIDERS]&quot;" />
    <CustomAction Id="InstallNoSideload" Directory="INSTALLFOLDER" Execute="deferred" Impersonate="yes" Return="check"
                  ExeCommand="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]installer\bootstrap.ps1&quot; -Action install -Providers &quot;[PROVIDERS]&quot; -NoSideload" />
    <CustomAction Id="StopBridge" Directory="INSTALLFOLDER" Execute="immediate" Return="ignore"
                  ExeCommand="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]installer\bootstrap.ps1&quot; -Action stop" />
    <CustomAction Id="Uninstall" Directory="INSTALLFOLDER" Execute="immediate" Return="ignore"
                  ExeCommand="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]installer\bootstrap.ps1&quot; -Action uninstall" />

    <InstallExecuteSequence>
      <!-- Before the files are replaced or removed, the bridge must let go of them. An upgrade keeps the registration and certificate. -->
      <Custom Action="StopBridge" Before="InstallInitialize" Condition="NOT Installed OR REMOVE=&quot;ALL&quot;" />
      <Custom Action="Uninstall" Before="InstallInitialize" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="Install" After="InstallFiles" Condition="NOT REMOVE AND NOT NOSIDELOAD" />
      <Custom Action="InstallNoSideload" After="InstallFiles" Condition="NOT REMOVE AND NOSIDELOAD" />
    </InstallExecuteSequence>

    <Feature Id="Main" Title="Office Partner" Level="1">
      <ComponentGroupRef Id="PackageFiles" />
      <ComponentGroupRef Id="CommandShim" />
      <ComponentGroupRef Id="Cleanup" />
    </Feature>
  </Package>
</Wix>
